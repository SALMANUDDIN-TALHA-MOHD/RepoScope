# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to GitHub.

PORT=5000

# GitHub — create a personal access token at github.com/settings/tokens
# Needs: repo (read), public_repo
GITHUB_TOKEN=your_github_token_here

# Supabase — find these in your Supabase project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Google Gemini — create a free key at aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend origin for CORS (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173
